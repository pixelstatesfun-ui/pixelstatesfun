PORT = 5000
HOST = localhost

REDIS_URL = redis://localhost:6379

MARIADB_HOST = localhost
MARIADB_USER = pixelplanet
MARIADB_PW = sqlpassword
MARIADB_DATABASE = pixelplanet

COOKIE_SECRET = somerandomstring

USE_PROXYCHECK = no

# IPQualityScore offline IP reputation database (Python 3.10+).
# Enable only after configuring a complete current IPQS database.
# When enabled, this takes precedence over the ProxyCheck web service.
USE_IPQS_DB = no
# Parent folder containing IPQualityScore (example: D:\IPQS\PythonIPQSDBReader)
IPQS_READER_PATH =
IPQS_DB_IPV4_PATH =
IPQS_DB_IPV6_PATH =
IPQS_PYTHON = python
IPQS_DB_CACHE_MS = 900000

WHOIS_DURATION = 240

ADMIN_IDS = 1, 2

USE_XREALIP = no

IS_CLUSTER = no

# WebSocket connection limits (adjust for available server capacity).
MAX_WS_CONNECTIONS = 5000
MAX_WS_CONNECTIONS_PER_IP = 50

HOURLY_EVENT = no

PUNISH_DOMINATOR = no

CAPTCHA_TIME = 30
TRUSTED_TIME = 48
CAPTCHA_PROVIDER = turnstile
# Get the public site key and private secret from Cloudflare Turnstile.
TURNSTILE_SITE_KEY =
TURNSTILE_SECRET_KEY =
# Optional; if unset, the request hostname is validated.
TURNSTILE_HOSTNAME =
TURNSTILE_ACTION = pixelplanet-

USE_MAILER = no
MAIL_ADDRESS = donotreply@excaptchaample.com

# VIP membership perks and cooldown multipliers (0.5 = half cooldown).
VIP_ENABLED = yes
FACTION_NAPS_ENABLED = yes
# Controls the entire alliances, coalitions, and wars system, including UI and API.
# Set to "no" to disable it completely; restart the server after changing.
WarEnable = yes
VIP_COOLDOWN_MULTIPLIER = 0.5
VIP_COOLDOWN_MULTIPLIER_NO_VOID = 0.95
VIP_PLUS_COOLDOWN_MULTIPLIER = 0.45
VIP_PLUS_COOLDOWN_MULTIPLIER_NO_VOID = 0.90
VIP_PLUS_PLUS_COOLDOWN_MULTIPLIER = 0.40
VIP_PLUS_PLUS_COOLDOWN_MULTIPLIER_NO_VOID = 0.80
# Optional private Discord webhook for Void event alerts.
VOID_WEBHOOK_URL =
VOID_PING_ROLE_ID =

# Optional Discord audit webhooks. Keep moderator/admin actions separate from
# ordinary user API activity.
MOD_AUDIT_WEBHOOK_URL =
USER_AUDIT_WEBHOOK_URL =

CONTACT_ADDRESS = admin@example.com
CHAT_INVITE = https://discord.gg/yv9bQpu5Y8

# Optional Discord-authenticated access gate for tester-only deployments.
# When enabled, the server fails to start unless Discord OAuth and an allowlist
# of Discord usernames are configured. Usernames are comma-separated.
# Discord's redirect URI must target /api/oauth/callback/discord on this site.
# Set COOKIE_SECRET to at least 32 random characters when enabling the gate.
TESTER_GATE_ENABLED = no
TESTER_DISCORD_USERNAMES =
DISCORD_CLIENT_ID =
DISCORD_CLIENT_SECRET =
DISCORD_R_URI =

# Discord bot login and optional role synchronization. DISCORD_BOT_TOKEN must
# be the Bot Token from the Discord Developer Portal, not the client secret.
# For role synchronization, add the bot to the guild and grant Manage Roles;
# its highest role must be above the configured role IDs.
DISCORD_BOT_TOKEN =
DISCORD_GUILD_ID =
DISCORD_ROLE_PRINCE_VIP =
DISCORD_ROLE_KING_VIP =
DISCORD_ROLE_EMPEROR_VIP =
DISCORD_ROLE_TRIAL_MOD =
DISCORD_ROLE_MODERATOR =

TOTAL_MEDIA_SIZE_MB = 51200
MAX_FILE_SIZE_MB = 50
MAX_UPLOAD_AMOUNT = 5
MAX_USER_MEDIA_SIZE_MB = 2048
