msgid "Chaos applies VIP multipliers to blank and occupied pixels."
msgstr "Во время хаотического события множители VIP применяются к пустым и занятым пикселям."

msgid "Without active Void: Prince 95%, King 90%, Emperor 80%."
msgstr "Без активной Пустоты: Принц — 95%, Король — 90%, Император — 80%."

msgid "During active Void, the configured active Void multipliers apply."
msgstr "Во время активной Пустоты применяются заданные для неё множители."

msgid "Regular Users Occupied Pixel Cooldown (ms)"
msgstr "Перезарядка занятого пикселя для обычных пользователей, мс"

msgid "Event Duration (minutes)"
msgstr "Длительность события (минуты)"

msgid "minutes"
msgstr "минут"

msgid "Quick duration"
msgstr "Быстрая настройка длительности"

msgid "Blank pixel settings are independent."
msgstr "Настройки перезарядки пустых пикселей задаются отдельно."

