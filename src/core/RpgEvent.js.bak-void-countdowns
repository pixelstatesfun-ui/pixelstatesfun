/*
 * This is an event that happens all 2h,
 * if the users complete, they will get rewarded by half the cooldown sitewide
 *
 */

import logger from './logger.js';
import {
  nextEvent,
  setNextEvent,
  setSuccess,
  getSuccess,
  getEventActive,
  getEventArea,
  clearOldEvent,
  startEventNow,
  setEventTimestamp,
  setEventActive,
  CANVAS_ID,
} from '../data/redis/Event.js';
import Void from './Void.js';
import { protectCanvasArea } from './Image.js';
import { setPixelByOffset } from './setPixel.js';
import { TILE_SIZE, EVENT_USER_NAME } from './constants.js';
import socketEvents from '../socket/socketEvents.js';
import { setState } from './SharedState.js';
import chatProvider from './ChatProvider.js';
import canvases from './canvases.js';
import { setVoidStatusProvider } from './VoidStatus.js';

// if there are more than USER_THRESHOLD users,
// void will not appear
const USER_THRESHOLD = 2000;
// steps in minutes for event stages
// STEPS[5] is the Void duration; the extra time gives players longer to defend.
const STEPS = [30, 10, 2, 1, 0, -20, -27, -52, -60];
// const STEPS = [4, 3, 2, 1, 0, -1, -2, -3, -4];
// gap between events in min, starting 1h after last event
// so 60 is a 2h gap, has to be higher than first and highest STEP numbers
const EVENT_GAP_MIN = 60;

/*
 * draw cross in center of chunk
 * @param centerCell chunk coordinates
 * @param clr color
 * @param style 0 solid, 1 dashed, 2 dashed invert
 * @param radius Radius (total width/height will be radius * 2 + 1)
 */
function drawCross(centerCell, clr, style, radius) {
  const [i, j] = centerCell;
  const center = (TILE_SIZE + 1) * TILE_SIZE / 2;
  if (style !== 2) {
    setPixelByOffset(CANVAS_ID, clr, i, j, center);
  }
  for (let r = 1; r < radius; r += 1) {
    if (style) {
      if (r % 2) {
        if (style === 1) continue;
      } else if (style === 2) {
        continue;
      }
    }
    let offset = center - TILE_SIZE * r;
    setPixelByOffset(CANVAS_ID, clr, i, j, offset);
    offset = center + TILE_SIZE * r;
    setPixelByOffset(CANVAS_ID, clr, i, j, offset);
    offset = center - r;
    setPixelByOffset(CANVAS_ID, clr, i, j, offset);
    offset = center + r;
    setPixelByOffset(CANVAS_ID, clr, i, j, offset);
  }
}


class RpgEvent {
  eventState; // number
  eventTimestamp; // number
  eventCenter; // Array
  eventCenterC; // Array
  eventArea; // Array
  // 0 if waiting
  // 1 if won
  // 2 if lost
  success; // boolean
  void; // Object
  chatTimeout; // number
  preparingBonusVoid;

  constructor() {
    this.runEventLoop = this.runEventLoop.bind(this);
    setVoidStatusProvider(() => this.getVoidStatusMessage());
  }

  async getVoidStatusMessage() {
    if (await getEventActive()) {
      return 'The Void is active now!';
    }
    const storedTimestamp = await nextEvent();
    const timestamp = Number.isFinite(storedTimestamp)
      ? storedTimestamp : this.eventTimestamp;
    if (!Number.isFinite(timestamp)) {
      return 'The next Void has not been scheduled yet.';
    }

    const now = Date.now();
    const nextVoidTimestamp = timestamp > now
      ? timestamp
      : timestamp + EVENT_GAP_MIN * 60 * 1000;
    const secondsLeft = Math.max(
      0,
      Math.ceil((nextVoidTimestamp - now) / 1000),
    );
    if (!secondsLeft) {
      return 'The next Void is starting now!';
    }
    const minutes = Math.floor(secondsLeft / 60);
    const seconds = secondsLeft % 60;
    const timeLeft = minutes
      ? `${minutes} minute${minutes === 1 ? '' : 's'}`
      : '';
    const remainingSeconds = seconds
      ? `${seconds} second${seconds === 1 ? '' : 's'}`
      : '';
    const duration = [timeLeft, remainingSeconds].filter(Boolean).join(' and ');
    return `The next Void starts in ${duration}.`;
  }

  setSuccess(success) {
    this.success = success;
    RpgEvent.setCoolDownFactorFromSuccess(success);
    return setSuccess(success);
  }

  static setCoolDownFactorFromSuccess(success) {
    let fac = 1;
    switch (success) {
      case 1:
        fac = 0.2;
        break;
      case 2:
        fac *= 2;
        break;
      default:
        // nothing
    }
    socketEvents.setCoolDownFactor(fac);
  }

  async initialize() {
    this.eventState = -1;
    this.eventCenterC = null;
    this.void = null;
    this.chatTimeout = 0;
    this.preparingBonusVoid = false;
    const success = await getSuccess();
    this.success = success;
    RpgEvent.setCoolDownFactorFromSuccess(success);
    if (socketEvents.important) {
      let eventTimestamp = await nextEvent();
      if (!eventTimestamp) {
        eventTimestamp = await RpgEvent.setNextEvent();
        await this.calcEventCenter();
        const [x, y, w, h] = this.eventArea;
        await protectCanvasArea(CANVAS_ID, x, y, w, h, true);
      }
      /*
       * This state is being updated in parallel now, while we do follow
       * redis. This update only happens to have other shards know when there
       * is void
       */
      await setState('void', { eventTimestamp });
      this.eventTimestamp = eventTimestamp;
      await this.calcEventCenter();
      logger.info('initialized Event');
    } else {
      logger.info('Loaded Event cooldown factor, but i am not running it');
    }
    this.runEventLoop();
  }

  eventTimer() {
    const now = Date.now();
    return Math.floor((this.eventTimestamp - now) / 1000);
  }

  async calcEventCenter() {
    const cCoor = await getEventArea();
    if (cCoor) {
      this.eventCenterC = cCoor;
      const {
        size: canvasSize,
      } = canvases[CANVAS_ID];
      const [ux, uy] = cCoor.map((z) => (z - 1) * TILE_SIZE - canvasSize / 2);
      this.eventArea = [ux, uy, TILE_SIZE * 3, TILE_SIZE * 3];
    }
  }

  static getDirection(x, y) {
    const { size: canvasSize } = canvases[CANVAS_ID];
    let direction = null;
    const distSquared = x ** 2 + y ** 2;

    if (distSquared < 1000 ** 2) direction = 'center';
    else if (x < 0 && y < 0) direction = 'North-West';
    else if (x >= 0 && y < 0) direction = 'North-East';
    else if (x < 0 && y >= 0) direction = 'South-West';
    else if (x >= 0 && y >= 0) direction = 'South-East';
    if (distSquared > (canvasSize / 2) ** 2) direction = `far ${direction}`;

    return direction;
  }

  static async setNextEvent() {
    // define next Event area
    const { size: canvasSize } = canvases[CANVAS_ID];
    // make sure that its the center of a 3x3 area
    const i = Math.floor(Math.random() * (canvasSize / TILE_SIZE - 2)) + 1;
    const j = Math.floor(Math.random() * (canvasSize / TILE_SIZE - 2)) + 1;
    // backup it and schedule next event in 1h
    await setNextEvent(EVENT_GAP_MIN, i, j);
    const eventTimestamp = await nextEvent();
    const x = i * TILE_SIZE - canvasSize / 2;
    const y = j * TILE_SIZE - canvasSize / 2;
    RpgEvent.broadcastChatMessage(
      `Suspicious activity spotted in ${RpgEvent.getDirection(x, y)}`,
    );
    drawCross([i, j], 19, 0, 13);
    logger.info(`Set next Event in 60min at ${x},${y}`);
    return eventTimestamp;
  }

  async summonBonusVoid() {
    if (!socketEvents.important) {
      throw new Error('Bonus Void can only be summoned on the main shard');
    }
    if (this.void || this.eventState === 11 || this.preparingBonusVoid) {
      throw new Error('A Void event is already active');
    }

    this.preparingBonusVoid = true;
    try {
      this.eventTimestamp = await RpgEvent.setNextEvent();
      await this.calcEventCenter();
      const [x, y, width, height] = this.eventArea;
      await protectCanvasArea(CANVAS_ID, x, y, width, height, true);
      await startEventNow();
      this.eventTimestamp = Date.now();
      if (!await setState('void', { eventTimestamp: this.eventTimestamp })) {
        throw new Error('Could not synchronize the bonus Void event');
      }
    } finally {
      this.preparingBonusVoid = false;
    }
    this.runEventLoop();
    return 'Bonus Void prepared and starting.';
  }

  static broadcastChatMessage(message) {
    if (chatProvider.enChannelId && chatProvider.eventUserId) {
      chatProvider.broadcastChatMessage(
        EVENT_USER_NAME,
        message,
        chatProvider.enChannelId,
        chatProvider.eventUserId,
      ).catch((error) => {
        logger.error(`Could not announce Void event status: ${error.message}`);
      });
    }
  }

  async finishWonEvent() {
    const [x, y, width, height] = this.eventArea;
    if (this.void) {
      this.void.cancel();
      this.void = null;
    }
    this.eventState = 12;
    this.eventTimestamp = Date.now() + STEPS[5] * 60 * 1000;
    await setEventActive(false);
    await this.setSuccess(1);
    await setEventTimestamp(this.eventTimestamp);
    if (!await setState('void', { eventTimestamp: this.eventTimestamp })) {
      throw new Error('Could not synchronize the completed Void event');
    }
    logger.info('Event got won early; applying the success cooldown.');
    RpgEvent.broadcastChatMessage(
      'Threat successfully defeated. Good work!',
    );
    await protectCanvasArea(CANVAS_ID, x, y, width, height, true);
  }

  async runEventLoop() {
    /*
     * if we aren't the main shard, we just wait and regularly check,
     * re-initializing if we become it
     */
    if (!socketEvents.important) {
      this.iAmNotImportant = true;
      if (this.void) {
        this.void.cancel();
        this.void = null;
      }
      setTimeout(this.runEventLoop, 180000);
      return;
    }
    if (this.preparingBonusVoid) {
      setTimeout(this.runEventLoop, 1000);
      return;
    }
    if (this.iAmNotImportant) {
      this.iAmNotImportant = false;
      this.initialize();
      return;
    }

    const {
      eventState,
    } = this;
    const eventSeconds = this.eventTimer();
    const eventMinutes = eventSeconds / 60;

    if (eventMinutes > STEPS[0]) {
      // 1h to 30min before Event: blinking dotted cross
      if (eventState !== 1) {
        this.eventState = 1;
        // color 15 protected
        drawCross(this.eventCenterC, 15, 1, 9);
        drawCross(this.eventCenterC, 0, 2, 9);
      } else {
        this.eventState = 2;
        drawCross(this.eventCenterC, 16, 2, 9);
        drawCross(this.eventCenterC, 0, 1, 9);
      }
      setTimeout(this.runEventLoop, 2000);
    } else if (eventMinutes > STEPS[1]) {
      // 10min to 30min before Event: blinking solid cross
      if (eventState !== 3 && eventState !== 4) {
        this.eventState = 3;
        const [x, y] = this.eventArea;
        RpgEvent.broadcastChatMessage(
          `Unstable area at ${RpgEvent.getDirection(x, y)} at concerning level`,
        );
      }
      if (eventState !== 3) {
        this.eventState = 3;
        drawCross(this.eventCenterC, 30, 1, 9);
        drawCross(this.eventCenterC, 0, 2, 9);
      } else {
        this.eventState = 4;
        drawCross(this.eventCenterC, 31, 2, 9);
        drawCross(this.eventCenterC, 0, 1, 9);
      }
      setTimeout(this.runEventLoop, 1500);
    } else if (eventMinutes > STEPS[2]) {
      // 2min to 10min before Event: blinking solid cross
      if (eventState !== 5) {
        this.eventState = 5;
        drawCross(this.eventCenterC, 12, 0, 7);
      } else {
        this.eventState = 6;
        drawCross(this.eventCenterC, 13, 0, 7);
      }
      setTimeout(this.runEventLoop, 1000);
    } else if (eventMinutes > STEPS[3]) {
      // 1min to 2min before Event: blinking solid cross red small
      if (eventState !== 7 && eventState !== 8) {
        this.eventState = 7;
        const [x, y] = this.eventArea;
        RpgEvent.broadcastChatMessage(
          `Alert! Threat is rising in 2min near ${RpgEvent.getDirection(x, y)}`,
        );
      }
      if (eventState !== 7) {
        drawCross(this.eventCenterC, 11, 0, 5);
        this.eventState = 7;
      } else {
        drawCross(this.eventCenterC, 12, 0, 5);
        this.eventState = 8;
      }
      setTimeout(this.runEventLoop, 1000);
    } else if (eventMinutes > STEPS[4]) {
      // 1min till Event: blinking solid cross red small faze
      if (eventState !== 9 && eventState !== 10) {
        this.eventState = 9;
        RpgEvent.broadcastChatMessage(
          'Alert! Danger!',
        );
      }
      if (eventState !== 9) {
        this.eventState = 9;
        drawCross(this.eventCenterC, 11, 0, 3);
      } else {
        this.eventState = 10;
        drawCross(this.eventCenterC, 19, 0, 3);
      }
      setTimeout(this.runEventLoop, 500);
    } else if (eventMinutes > STEPS[5]) {
      if (eventState !== 11) {
        // start event
        this.eventState = 11;
        const [x, y, w, h] = this.eventArea;
        await protectCanvasArea(CANVAS_ID, x, y, w, h, false);
        logger.info(`Starting Event at ${x},${y} now`);
        const [centerI, centerJ] = this.eventCenterC;
        const { size: canvasSize } = canvases[CANVAS_ID];
        const centerX = centerI * TILE_SIZE + TILE_SIZE / 2 - canvasSize / 2;
        const centerY = centerJ * TILE_SIZE + TILE_SIZE / 2 - canvasSize / 2;
        // Give users a 20-minute window to contain the Void.
        const targetDuration = STEPS[5] * -1;
        const terrain = await Void.loadTerrain(this.eventCenterC);
        this.void = new Void(
          this.eventCenterC,
          targetDuration,
          terrain,
          () => {
            this.finishWonEvent().catch((error) => {
              logger.error(`Could not finish contained Void: ${error.message}`);
            });
          },
        );
        await setEventActive(true);
        RpgEvent.broadcastChatMessage(
          // eslint-disable-next-line max-len
          `Void is appearing at [#d,${centerX},${centerY},30](/#d,${centerX},${centerY},30). Fight starting!`,
        );
      } else if (this.void) {
        const percent = this.void.checkStatus();
        if (this.void.defeated) {
          await this.finishWonEvent();
        } else if (percent === 100) {
          // event lost
          logger.info(`Event got lost after ${Math.abs(eventMinutes)} min`);
          RpgEvent.broadcastChatMessage(
            'Threat couldn\'t be contained, abandon area',
          );
          this.setSuccess(2);
          this.void = null;
          await setEventActive(false);
          const [x, y, w, h] = this.eventArea;
          await protectCanvasArea(CANVAS_ID, x, y, w, h, true);
        } else {
          const now = Date.now();
          if (now > this.chatTimeout) {
            RpgEvent.broadcastChatMessage(
              `Void reached ${percent}% of its max size`,
            );
            this.chatTimeout = now + 40000;
          }
        }
      }
      setTimeout(this.runEventLoop, 1000);
    } else if (eventMinutes > STEPS[6]) {
      if (eventState !== 12) {
        // check if won
        if (this.void) {
          if (this.void.checkStatus() !== 100) {
            // event won
            logger.info('Event got won! Cooldown sitewide now half.');
            RpgEvent.broadcastChatMessage(
              'Threat successfully defeated. Good work!',
            );
            this.setSuccess(1);
          }
          this.void.cancel();
          this.void = null;
        }
        this.eventState = 12;
      }
      setTimeout(this.runEventLoop, 60000);
    } else if (eventMinutes > STEPS[7]) {
      if (eventState !== 13) {
        // 32min after the Void event ended.
        // end debuff if lost
        if (this.success === 2) {
          RpgEvent.broadcastChatMessage(
            'Void seems to leave again.',
          );
          this.setSuccess(0);
        }
        this.eventState = 13;
      }
      setTimeout(this.runEventLoop, 60000);
    } else if (eventMinutes > STEPS[8]) {
      if (eventState !== 14) {
        // 40min after the Void event ended.
        // clear old event area
        // reset success state
        logger.info('Restoring old Event area');
        await clearOldEvent();
        if (this.success === 1) {
          RpgEvent.broadcastChatMessage(
            'Celebration time over, get back to work.',
          );
          this.setSuccess(0);
        }
        this.eventState = 14;
      }
      // 40min after the last event started.
      // do nothing
      setTimeout(this.runEventLoop, 60000);
    } else {
      // 60min after the last event started / 1h before the next Event.
      // define and protect it
      if (socketEvents.onlineCounter.total < USER_THRESHOLD) {
        const eventTimestamp = await RpgEvent.setNextEvent();
        this.eventTimestamp = eventTimestamp;
        setState('void', { eventTimestamp });
        await this.calcEventCenter();
        const [x, y, w, h] = this.eventArea;
        await protectCanvasArea(CANVAS_ID, x, y, w, h, true);
      }
      setTimeout(this.runEventLoop, 60000);
    }
  }
}

const rpgEvent = new RpgEvent();

export default rpgEvent;
